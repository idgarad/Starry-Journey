/target/

# User-supplied background music. Users provide their own tracks, which are
# large binaries and often under copyright, so nothing here is committed
# except the README that explains the folder. See docs/product.md.
/Sounds/Music/*
!/Sounds/Music/README.md

# Agent working references: kept locally for tuning, never committed.
# Only the handoff note is tracked.
/.ai/*
!/.ai/handoff.md
